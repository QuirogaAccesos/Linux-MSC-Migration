<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>TREA</Product>
    <Title>TREA</Title>
    <PackageId>TREA</PackageId>
    <AssemblyName>TREA</AssemblyName>
    <Company>TREA</Company>
    <Authors>Sebasq10</Authors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="PrintingTemplates\PrintingConfig.xml" />
    <None Remove="PrintingTemplates\PrintingTest.txt" />
    <None Remove="Tools\SumatraPDF.exe" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="PrintingTemplates\PrintingConfig.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PrintingTemplates\PermitReceipt.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PrintingTemplates\ReservationReceipt.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PrintingTemplates\PrintingTest.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\SumatraPDF.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="QuestPDF" Version="2025.5.1" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.9" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.5" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.5" />
    <PackageReference Include="System.IO.Ports" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetailProtocolCore\RetailProtocolCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BAC-ECR">
      <HintPath>Controllers\CardPayment\BAC-ECR.dll</HintPath>
    </Reference>
    <Reference Include="PicobController">
      <HintPath>Controllers\Picob\PicobController.dll</HintPath>
    </Reference>
    <Reference Include="RetailProtocolIntegration">
      <HintPath>Controllers\CardPayment\RetailProtocolIntegration.dll</HintPath>
    </Reference>
    <Reference Include="TREAPrinting">
      <HintPath>Controllers\Printer\TREAPrinting.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>